  "dependencies": {
    "@vantage-ai/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0",
    "@angular/common": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0",
    "rxjs": "^7.0.0",
    "zone.js": "^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0"
  },
  "devDependencies": {
    "@angular/core": "^17.0.0",
    "@angular/common": "^17.0.0",
    "rxjs": "^7.8.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "zone.js": "^0.14.2"
  }
