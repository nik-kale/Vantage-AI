{
  "name": "@vantage-ai/web-components",
  "version": "7.0.0",
  "description": "Framework-agnostic Web Components for Vantage AI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
