  "dependencies": {
    "@vantage-ai/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.60.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
