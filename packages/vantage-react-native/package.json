{
  "name": "@vantage-ai/react-native",
  "version": "6.0.0",
  "description": "React Native SDK for Vantage AI with mobile session replay",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
