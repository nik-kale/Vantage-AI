{
  "name": "@vantage-ai/dashboards",
  "version": "6.0.0",
  "description": "Custom analytics dashboards with visualizations for Vantage AI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
