{
  "name": "@vantage-ai/svelte",
  "version": "5.0.0",
  "description": "Svelte support for Vantage AI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "svelte": "src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest"
  },
  "keywords": [
    "svelte",
    "vantage-ai",
    "ux",
    "analytics"
  ],
  "author": "Vantage AI",
  "license": "MIT",
  "dependencies": {
    "@vantage-ai/sdk": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "svelte": "^4.2.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
